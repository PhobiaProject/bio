<title>WILDLANDS — Rust-inspired Survival</title>
<style>
:root{--panel:rgba(13,15,15,.76);--line:rgba(205,190,160,.28);--text:#eee9df;--muted:#b9b1a3;--orange:#c45d36}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#101514;color:var(--text);font-family:Arial,Helvetica,sans-serif}canvas{display:block}#game{position:fixed;inset:0}#hud{position:fixed;inset:0;pointer-events:none;text-shadow:0 2px 4px #000}
.top{position:absolute;top:18px;left:18px;display:flex;gap:8px;align-items:center}.brand{font-size:13px;letter-spacing:.18em;font-weight:900;background:var(--panel);border:1px solid var(--line);padding:10px 13px;border-radius:2px;text-transform:uppercase}.status{font-size:12px;color:#d5dfd9;background:var(--panel);padding:10px 12px;border-radius:5px;border:1px solid var(--line)}
.stats{position:absolute;left:18px;bottom:18px;width:min(290px,calc(100vw - 36px));display:grid;gap:7px}.stat{background:var(--panel);border:1px solid var(--line);padding:8px 10px;border-radius:4px;display:grid;grid-template-columns:74px 1fr 34px;gap:8px;align-items:center;font-size:11px;letter-spacing:.08em}.bar{height:7px;background:#303a39;border-radius:2px;overflow:hidden}.fill{height:100%;width:100%;background:#76aa80;transition:width .2s}.stat:nth-child(2) .fill{background:#d4a75e}.stat:nth-child(3) .fill{background:#6ca9d0}
.crosshair{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:18px;height:18px}.crosshair:before,.crosshair:after{content:"";position:absolute;background:#e6e3d9;box-shadow:0 0 3px #000}.crosshair:before{width:2px;height:18px;left:8px}.crosshair:after{height:2px;width:18px;top:8px}
.center-msg{position:absolute;top:58%;left:50%;transform:translateX(-50%);font-size:12px;color:#fff;background:rgba(0,0,0,.5);padding:7px 12px;border-radius:4px;white-space:nowrap}.right{position:absolute;right:18px;top:18px;width:190px;background:var(--panel);border:1px solid var(--line);padding:12px;border-radius:5px}.right h3{font-size:11px;letter-spacing:.15em;margin:0 0 10px;color:var(--orange)}.resource{display:flex;justify-content:space-between;font-size:12px;padding:5px 0;color:#e6e6df}.resource span:last-child{font-variant-numeric:tabular-nums}
.hotbar{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);display:flex;gap:5px}.slot{width:58px;height:60px;background:rgba(20,22,21,.82);border:1px solid rgba(215,205,185,.32);border-radius:1px;display:flex;flex-direction:column;justify-content:space-between;padding:5px;font-size:10px;color:#d9dfdc}.slot.active{border:2px solid #d18b3e;background:rgba(54,69,72,.94);box-shadow:inset 0 0 0 1px #000}.slot b{font-size:18px;font-weight:500}.slot small{text-align:right;color:#fff}
.help{position:absolute;right:18px;bottom:18px;text-align:right;font-size:11px;color:#d1d8d3;line-height:1.7}.help kbd{background:#111b1a;border:1px solid #66716b;border-radius:3px;padding:2px 5px;color:white}
.overlay{position:fixed;inset:0;display:grid;place-items:center;background:linear-gradient(180deg,rgba(8,15,17,.6),rgba(7,12,13,.85));z-index:5}.menu{width:min(540px,calc(100vw - 32px));padding:30px;background:rgba(12,19,19,.92);border:1px solid rgba(255,255,255,.2);box-shadow:0 25px 100px #0008}.eyebrow{color:var(--orange);font-size:11px;letter-spacing:.28em;font-weight:800}.menu h1{font-size:clamp(34px,7vw,58px);line-height:.95;letter-spacing:-.05em;margin:14px 0}.menu p{color:#c1cbc6;line-height:1.6;font-size:14px}.menu button{border:0;background:var(--orange);color:#17120d;font-weight:900;letter-spacing:.12em;padding:14px 18px;margin-top:10px;cursor:pointer;width:100%}.menu button:hover{filter:brightness(1.1)}.note{font-size:11px!important;color:#87938e!important}
#toast{position:absolute;top:78px;left:50%;transform:translateX(-50%);background:rgba(10,15,15,.9);padding:10px 16px;border:1px solid var(--line);border-radius:4px;font-size:12px;opacity:0;transition:opacity .2s}
@media(max-width:650px){.right{top:auto;bottom:100px;right:10px;width:140px;padding:8px}.top{top:10px;left:10px;gap:4px}.brand,.status{padding:8px;font-size:10px}.help{display:none}.slot{width:43px;height:49px}.stats{left:10px;bottom:10px;width:180px}.stat{grid-template-columns:54px 1fr 26px;padding:6px;font-size:9px}.hotbar{bottom:10px;left:auto;right:10px;transform:none}}

.inventory-panel{position:fixed;inset:0;z-index:6;display:none;place-items:center;background:rgba(4,7,7,.78);backdrop-filter:blur(4px)}
.inventory-window{width:min(820px,calc(100vw - 24px));max-height:calc(100vh - 24px);overflow:auto;background:#171a18;border:1px solid #817966;padding:18px;box-shadow:0 24px 90px #000a}
.inventory-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #554f44;padding-bottom:12px;margin-bottom:14px}
.inventory-head h2{margin:0;font-size:20px;letter-spacing:.14em}
.inventory-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.panel-block{border:1px solid #514d43;padding:12px;background:#151918}
.panel-block h3{margin:0 0 10px;color:#c45d36;font-size:11px;letter-spacing:.2em}
.item-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.item-cell{aspect-ratio:1;background:#272b28;border:1px solid #514f46;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;font-size:11px;color:#e8e1d4}.item-cell b{font-size:23px;font-weight:400}
.recipe{display:flex;align-items:center;justify-content:space-between;gap:8px;border-bottom:1px solid #393b35;padding:10px 0;font-size:12px}.recipe button,.close-inventory{border:1px solid #a66a42;background:#9e4c2d;color:#fff0df;padding:8px 10px;font-weight:800;cursor:pointer}.recipe button:disabled{opacity:.35;cursor:not-allowed}.inv-note{font-size:11px;color:#a9ada5;line-height:1.5}
@media(max-width:650px){.inventory-grid{grid-template-columns:1fr}.inventory-window{padding:10px}}
</style>
</head>
<body>
<div id="game"></div>
<div id="hud">
  <div class="top"><div class="brand"><span style="color:var(--orange)">▧</span> WILDLANDS</div><div class="status" id="day">ДЕНЬ 1 · 08:00</div></div><div id="compass" style="position:absolute;top:18px;left:50%;transform:translateX(-50%);font-size:11px;letter-spacing:.32em;color:#f1eee6;background:rgba(10,13,13,.35);padding:7px 18px;border-bottom:1px solid #d2c6ad66">NW&nbsp;&nbsp;  N&nbsp;&nbsp;  NE&nbsp;&nbsp;  E&nbsp;&nbsp;  SE</div>
  <div class="crosshair"></div><div class="center-msg" id="prompt">Нажми «Начать» и исследуй остров</div>
  <div class="right"><h3>РЕСУРСЫ / INVENTORY</h3><div class="resource">🪵 Дерево <span id="wood">0</span></div><div class="resource">🪨 Камень <span id="stone">0</span></div><div class="resource">⛓ Металл <span id="metal">0</span></div><div class="resource">🍓 Еда <span id="food">3</span></div></div>
  <div class="stats">
    <div class="stat"><span>ЗДОРОВЬЕ</span><div class="bar"><div class="fill" id="healthbar"></div></div><b id="health">100</b></div>
    <div class="stat"><span>ГОЛОД</span><div class="bar"><div class="fill" id="hungerbar"></div></div><b id="hunger">100</b></div>
    <div class="stat"><span>ЖАЖДА</span><div class="bar"><div class="fill" id="thirstbar"></div></div><b id="thirst">100</b></div>
  </div>
  <div class="hotbar" id="hotbar"><div class="slot active"><span>1</span><b>🪓</b><small>Топор</small></div><div class="slot"><span>2</span><b>⛏</b><small>Кирка</small></div><div class="slot"><span>3</span><b>🏗</b><small>Стройка</small></div><div class="slot"><span>4</span><b>🍓</b><small>Еда</small></div><div class="slot"><span>5</span><b>💧</b><small>Вода</small></div></div>
  <div class="help"><kbd>W A S D</kbd> ДВИЖЕНИЕ · <kbd>SHIFT</kbd> БЕГ<br><kbd>ЛКМ</kbd> УДАР / ДОБЫЧА · <kbd>E</kbd> ИСПОЛЬЗОВАТЬ<br><kbd>1–5</kbd> СЛОТЫ · <kbd>ESC</kbd> МЕНЮ</div>
  <div id="toast"></div>
</div>

<div class="inventory-panel" id="inventoryPanel"><div class="inventory-window">
<div class="inventory-head"><h2>ИНВЕНТАРЬ / КРАФТ</h2><button class="close-inventory" id="closeInventory">ЗАКРЫТЬ [TAB]</button></div>
<div class="inventory-grid">
<div class="panel-block"><h3>СОДЕРЖИМОЕ РЮКЗАКА</h3><div class="item-grid">
<div class="item-cell"><b>🪵</b>Дерево <strong id="invWood">0</strong></div><div class="item-cell"><b>🪨</b>Камень <strong id="invStone">0</strong></div>
<div class="item-cell"><b>⛓</b>Металл <strong id="invMetal">0</strong></div><div class="item-cell"><b>🍓</b>Ягоды <strong id="invFood">3</strong></div>
<div class="item-cell"><b>💧</b>Вода <strong id="invWater">2</strong></div><div class="item-cell"><b>🪓</b>Топор <small>инструмент</small></div>
<div class="item-cell"><b>🏹</b>Лук <small>оружие</small></div><div class="item-cell"><b>🏗</b>План <small>стройка</small></div>
</div><p class="inv-note">Собирай ресурсы и создавай предметы. Постройки появятся перед персонажем.</p></div>
<div class="panel-block"><h3>РЕЦЕПТЫ</h3>
<div class="recipe"><span>🏹 Примитивный лук<br><small>50 дерева · 10 камня</small></span><button id="craftBow">СОЗДАТЬ</button></div>
<div class="recipe"><span>🏠 Деревянный фундамент<br><small>50 дерева</small></span><button id="craftFloor">СОЗДАТЬ</button></div>
<div class="recipe"><span>🧱 Стена<br><small>30 дерева · 40 камня</small></span><button id="craftWall">СОЗДАТЬ</button></div>
<div class="recipe"><span>🔥 Костёр<br><small>25 дерева · 5 камня</small></span><button id="craftFire">СОЗДАТЬ</button></div>
</div></div></div></div>
<div class="overlay" id="overlay"><div class="menu"><div class="eyebrow">ISLAND • SURVIVAL • BUILD</div><h1>ВЫЖИВАНИЕ<br>НАЧИНАЕТСЯ.</h1><p>Ты один на суровом острове. Добывай дерево и камень, ищи припасы, следи за голодом и жаждой. Построй первое укрытие до наступления темноты.</p><p class="note">Браузерный survival-прототип · WASD / мышь · рекомендуется играть на компьютере</p><button id="start">НАЧАТЬ ВЫЖИВАНИЕ</button></div></div>
<script type="module">
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';
const root=document.querySelector('#game');
const scene=new THREE.Scene(); scene.background=new THREE.Color(0x9aafb1); scene.fog=new THREE.Fog(0x9aafb1,28,95);
const camera=new THREE.PerspectiveCamera(72,innerWidth/innerHeight,.1,220); camera.position.set(0,2,8);
const renderer=new THREE.WebGLRenderer({antialias:true}); renderer.setPixelRatio(Math.min(devicePixelRatio,2)); renderer.setSize(innerWidth,innerHeight); renderer.shadowMap.enabled=true; renderer.shadowMap.type=THREE.PCFSoftShadowMap; renderer.outputColorSpace=THREE.SRGBColorSpace; root.appendChild(renderer.domElement);
scene.add(new THREE.HemisphereLight(0xd5dfdc,0x373a2c,1.45));
const sun=new THREE.DirectionalLight(0xffd7a0,2.65);sun.position.set(-35,55,25);sun.castShadow=true;sun.shadow.mapSize.set(1024,1024);sun.shadow.camera.left=-55;sun.shadow.camera.right=55;sun.shadow.camera.top=55;sun.shadow.camera.bottom=-55;scene.add(sun);
const mat=(color,roughness=1)=>new THREE.MeshStandardMaterial({color,roughness});
const grass=mat(0x536544), sand=mat(0x9e8b68), trunk=mat(0x4c3424), leaves=[mat(0x233e2d),mat(0x2d4d34),mat(0x3a5638)], rockMat=mat(0x686b67), metalMat=mat(0x4c5d60), waterMat=new THREE.MeshStandardMaterial({color:0x3e7780,roughness:.32,metalness:.18});
const ground=new THREE.Mesh(new THREE.PlaneGeometry(220,220,1,1),grass);ground.rotation.x=-Math.PI/2;ground.position.y=-.12;ground.receiveShadow=true;scene.add(ground);
const sea=new THREE.Mesh(new THREE.PlaneGeometry(500,500),waterMat);sea.rotation.x=-Math.PI/2;sea.position.y=-1.2;scene.add(sea);
const beach=new THREE.Mesh(new THREE.RingGeometry(29,37,96),sand);beach.rotation.x=-Math.PI/2;beach.position.y=-.09;scene.add(beach);
const collidables=[];
const detailMats=[mat(0x6f7747),mat(0x83805a),mat(0x4c5b39)];
for(let i=0;i<520;i++){
  const a=Math.random()*Math.PI*2, r=4+Math.random()*31;
  const x=Math.cos(a)*r,z=Math.sin(a)*r;
  if(r>34) continue;
  const tuft=new THREE.Group();
  for(let j=0;j<3;j++){
    const blade=new THREE.Mesh(new THREE.ConeGeometry(.035+Math.random()*.025,.24+Math.random()*.35,3),detailMats[j%3]);
    blade.position.set((Math.random()-.5)*.16,.12,(Math.random()-.5)*.16);
    blade.rotation.z=(Math.random()-.5)*.6; tuft.add(blade);
  }
  tuft.position.set(x,0,z); tuft.rotation.y=Math.random()*Math.PI;
  scene.add(tuft);
}
function addTree(x,z,s=1){const g=new THREE.Group();g.position.set(x,0,z);g.scale.setScalar(s);
 const t=new THREE.Mesh(new THREE.CylinderGeometry(.22,.34,2.8,7),trunk);t.position.y=1.35;t.castShadow=true;g.add(t);
 for(let i=0;i<3;i++){const c=new THREE.Mesh(new THREE.ConeGeometry(1.25-i*.18,2.2,7),leaves[(Math.random()*leaves.length)|0]);c.position.y=2.4+i*.72;c.castShadow=true;g.add(c)}
 scene.add(g);collidables.push({obj:g,type:'tree',x,z,r:1.1*s,hp:3});}
function addRock(x,z,s=1,metal=false){const mesh=new THREE.Mesh(new THREE.DodecahedronGeometry(.75*s,0),metal?metalMat:rockMat);mesh.position.set(x,.45*s,z);mesh.scale.set(1.2,.75,.9);mesh.rotation.set(Math.random(),Math.random()*3,Math.random());mesh.castShadow=true;mesh.receiveShadow=true;scene.add(mesh);collidables.push({obj:mesh,type:metal?'metal':'rock',x,z,r:.8*s,hp:2});}
for(let i=0;i<135;i++){let a=Math.random()*Math.PI*2,r=7+Math.random()*26,x=Math.cos(a)*r,z=Math.sin(a)*r;if(r>30)continue;if(Math.random()<.72)addTree(x,z,.7+Math.random()*.7);else addRock(x,z,.7+Math.random()*.8,Math.random()<.18)}
// A small ruined camp and a landmark make the island readable.
const ruin=new THREE.Group();for(let i=0;i<4;i++){let p=new THREE.Mesh(new THREE.BoxGeometry(.22,1.8,.22),trunk);p.position.set(Math.cos(i*Math.PI/2)*2,.9,Math.sin(i*Math.PI/2)*2);p.rotation.z=(i%2?-.08:.08);ruin.add(p)}let roof=new THREE.Mesh(new THREE.BoxGeometry(4.3,.2,4.3),mat(0x71634b));roof.position.y=1.9;roof.rotation.y=.2;ruin.add(roof);ruin.position.set(-7,0,-8);scene.add(ruin);
// Distant industrial wreck silhouettes on the horizon.
for(let i=0;i<7;i++){
  const x=-42+i*14,z=-49-Math.random()*10;
  const tower=new THREE.Group();
  const legmat=mat(0x555b55);
  const leg=new THREE.Mesh(new THREE.CylinderGeometry(.16,.24,8+Math.random()*5,5),legmat);
  leg.position.y=4; tower.add(leg);
  const cross=new THREE.Mesh(new THREE.BoxGeometry(3.4,.18,.2),legmat);cross.position.y=6;tower.add(cross);
  tower.position.set(x,0,z);scene.add(tower);
}
const player={x:0,z:7,y:1.7,yaw:0,pitch:0,health:100,hunger:100,thirst:100,wood:0,stone:0,metal:0,food:3,water:2,selected:1,alive:true};
let running=false,locked=false,last=performance.now(),elapsed=0,daytime=8,toastTimer=0,swing=0,lastHit=0;
const keys={}; const toast=document.querySelector('#toast'),prompt=document.querySelector('#prompt');
function say(t){toast.textContent=t;toast.style.opacity=1;toastTimer=2.4}
function ui(){for(const k of ['wood','stone','metal','food'])document.getElementById(k).textContent=player[k];
for(const k of ['wood','stone','metal','food','water']){const el=document.getElementById('inv'+k[0].toUpperCase()+k.slice(1));if(el)el.textContent=player[k]}
const requirements={craftBow:player.wood<50||player.stone<10,craftFloor:player.wood<50,craftWall:player.wood<30||player.stone<40,craftFire:player.wood<25||player.stone<5};
for(const id in requirements){const b=document.getElementById(id);if(b)b.disabled=requirements[id]}
for(const k of ['health','hunger','thirst']){document.getElementById(k).textContent=Math.ceil(player[k]);document.getElementById(k+'bar').style.width=Math.max(0,player[k])+'%'}document.querySelectorAll('.slot').forEach((e,i)=>e.classList.toggle('active',i+1===player.selected))}
const axe= new THREE.Group();const handle=new THREE.Mesh(new THREE.CylinderGeometry(.045,.055,.9,6),trunk);handle.rotation.z=-.4;handle.position.set(.28,-.27,-.5);axe.add(handle);const blade=new THREE.Mesh(new THREE.DodecahedronGeometry(.19,0),rockMat);blade.scale.set(1.25,.85,.38);blade.position.set(.48,.02,-.52);blade.rotation.z=-.4;axe.add(blade);camera.add(axe);axe.position.set(.32,-.38,-.7);scene.add(camera);
const arm=new THREE.Group();const skin=mat(0x986d4d),wrap=mat(0x4c4337);
const forearm=new THREE.Mesh(new THREE.CylinderGeometry(.09,.13,.52,7),skin);forearm.rotation.z=-.65;forearm.position.set(.32,-.48,-.42);arm.add(forearm);
const wrist=new THREE.Mesh(new THREE.CylinderGeometry(.105,.105,.13,7),wrap);wrist.rotation.z=-.65;wrist.position.set(.42,-.3,-.48);arm.add(wrist);camera.add(arm);
const raycaster=new THREE.Raycaster();raycaster.far=4.4;
function target(){raycaster.setFromCamera(new THREE.Vector2(0,0),camera);let hits=raycaster.intersectObjects(collidables.map(o=>o.obj),true);if(!hits.length)return null;let o=hits[0].object;while(o&&!collidables.some(c=>c.obj===o))o=o.parent;return collidables.find(c=>c.obj===o)||null}
function collect(){if(!running)return;if(performance.now()-lastHit<260)return;lastHit=performance.now();swing=1;const t=target();if(!t){say('Подойди ближе к дереву или камню');return}if(t.type==='tree'){player.wood+=12;t.hp--;say(' +12 дерева');}else if(t.type==='rock'){player.stone+=8;t.hp--;say(' +8 камня')}else{player.metal+=4;t.hp--;say(' +4 металла')}if(t.hp<=0){scene.remove(t.obj);collidables.splice(collidables.indexOf(t),1)}ui()}
function interact(){if(player.selected===3){if(player.wood>=30&&player.stone>=10){player.wood-=30;player.stone-=10;const b=new THREE.Mesh(new THREE.BoxGeometry(2.8,1.8,2.8),mat(0x806345));b.position.set(player.x+Math.sin(player.yaw)*4,.9,player.z-Math.cos(player.yaw)*4);b.castShadow=true;scene.add(b);say('Укрытие построено! −30 дерева, −10 камня');ui()}else say('Для укрытия нужно 30 дерева и 10 камня')}else if(player.selected===4){if(player.food>0){player.food--;player.hunger=Math.min(100,player.hunger+28);say('Ты съел ягоды: +голод');ui()}else say('Еды нет')}else if(player.selected===5){if(player.water>0){player.water--;player.thirst=Math.min(100,player.thirst+35);say('Ты выпил воду: +жажда');ui()}else say('Воды нет')}else collect()}
function placeBuild(kind){
 let obj;
 if(kind==='floor'){obj=new THREE.Mesh(new THREE.BoxGeometry(3,.22,3),mat(0x76583b));obj.position.set(player.x+Math.sin(player.yaw)*4,.12,player.z-Math.cos(player.yaw)*4);}
 if(kind==='wall'){obj=new THREE.Mesh(new THREE.BoxGeometry(3,2.1,.22),mat(0x67472e));obj.position.set(player.x+Math.sin(player.yaw)*4,1.15,player.z-Math.cos(player.yaw)*4);}
 if(kind==='fire'){obj=new THREE.Group();const ring=new THREE.Mesh(new THREE.TorusGeometry(.42,.12,5,9),rockMat);ring.rotation.x=Math.PI/2;ring.position.y=.12;obj.add(ring);const flame=new THREE.Mesh(new THREE.ConeGeometry(.22,.7,6),new THREE.MeshBasicMaterial({color:0xff6a18}));flame.position.y=.48;obj.add(flame);obj.position.set(player.x+Math.sin(player.yaw)*2,0,player.z-Math.cos(player.yaw)*2);}
 if(obj){obj.castShadow=true;obj.receiveShadow=true;scene.add(obj)}
}
function craft(id){
 if(id==='craftBow'&&player.wood>=50&&player.stone>=10){player.wood-=50;player.stone-=10;say('Создан примитивный лук');}
 else if(id==='craftFloor'&&player.wood>=50){player.wood-=50;placeBuild('floor');say('Фундамент установлен');}
 else if(id==='craftWall'&&player.wood>=30&&player.stone>=40){player.wood-=30;player.stone-=40;placeBuild('wall');say('Стена установлена');}
 else if(id==='craftFire'&&player.wood>=25&&player.stone>=5){player.wood-=25;player.stone-=5;placeBuild('fire');say('Костёр установлен');}
 else say('Не хватает ресурсов');ui();
}
for(const id of ['craftBow','craftFloor','craftWall','craftFire'])document.getElementById(id).addEventListener('click',()=>craft(id));
const invPanel=document.getElementById('inventoryPanel');
function toggleInventory(force){const open=typeof force==='boolean'?force:invPanel.style.display!=='grid';invPanel.style.display=open?'grid':'none';if(open&&document.pointerLockElement)document.exitPointerLock();else if(!open&&running)renderer.domElement.requestPointerLock?.();ui()}
document.getElementById('closeInventory').addEventListener('click',()=>toggleInventory(false));
function start(){document.querySelector('#overlay').style.display='none';running=true;renderer.domElement.requestPointerLock?.();say('Выживай. Собирай ресурсы. Найди укрытие.')}
document.querySelector('#start').addEventListener('click',start);
document.addEventListener('pointerlockchange',()=>locked=document.pointerLockElement===renderer.domElement);
document.addEventListener('mousemove',e=>{if(!running||!locked)return;player.yaw-=e.movementX*.002;player.pitch-=e.movementY*.002;player.pitch=Math.max(-1.25,Math.min(1.25,player.pitch));camera.rotation.order='YXZ';camera.rotation.y=player.yaw;camera.rotation.x=player.pitch});
document.addEventListener('keydown',e=>{if(['KeyW','KeyA','KeyS','KeyD','Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code))e.preventDefault();if(e.code==='Tab'){e.preventDefault();if(running)toggleInventory();return}if(invPanel.style.display==='grid'&&e.code==='Escape'){toggleInventory(false);return}keys[e.code]=true;if(['Digit1','Digit2','Digit3','Digit4','Digit5'].includes(e.code)){player.selected=Number(e.code.slice(-1));ui()}if(e.code==='KeyE')interact();if(e.code==='Escape'&&running){running=false;document.querySelector('#overlay').style.display='grid';document.querySelector('#start').textContent='ПРОДОЛЖИТЬ';document.querySelector('#start').onclick=()=>{document.querySelector('#overlay').style.display='none';running=true;renderer.domElement.requestPointerLock?.()}}if(e.code==='Space')e.preventDefault()});
document.addEventListener('keyup',e=>keys[e.code]=false);renderer.domElement.addEventListener('mousedown',e=>{if(!running)return;if(!locked){renderer.domElement.requestPointerLock?.();return}if(e.button===0)interact()});
document.addEventListener('contextmenu',e=>e.preventDefault());
function animate(now){requestAnimationFrame(animate);const dt=Math.min((now-last)/1000,.05);last=now;
 if(running&&player.alive&&invPanel.style.display!=='grid'){elapsed+=dt;daytime=(8+elapsed/45)%24;player.hunger=Math.max(0,player.hunger-dt*.12);player.thirst=Math.max(0,player.thirst-dt*.19);if(player.hunger===0||player.thirst===0)player.health=Math.max(0,player.health-dt*.8);if(player.health<=0){player.alive=false;running=false;document.querySelector('.menu h1').innerHTML='ТЫ НЕ<br>ВЫЖИЛ.';document.querySelector('.menu p').textContent='Остров забрал ещё одну жизнь. Попробуй снова.';document.querySelector('#start').textContent='НАЧАТЬ ЗАНОВО';document.querySelector('#start').onclick=()=>location.reload();document.querySelector('#overlay').style.display='grid'}const speed=keys.ShiftLeft?8:5;let f=(keys.KeyW?1:0)-(keys.KeyS?1:0),s=(keys.KeyD?1:0)-(keys.KeyA?1:0);const len=Math.hypot(f,s)||1;player.x+=(-Math.sin(player.yaw)*f+Math.cos(player.yaw)*s)/len*speed*dt;player.z+=(-Math.cos(player.yaw)*f-Math.sin(player.yaw)*s)/len*speed*dt;let r=Math.hypot(player.x,player.z);if(r>31){player.x*=31/r;player.z*=31/r}camera.position.set(player.x,1.7,player.z);document.querySelector('#day').textContent='ДЕНЬ '+(1+Math.floor(elapsed/180))+' · '+String(Math.floor(daytime)).padStart(2,'0')+':'+String(Math.floor((daytime%1)*60)).padStart(2,'0');document.querySelector('#compass').style.transform='translateX(-50%) rotate('+(player.yaw*8)+'deg)';const t=target();prompt.textContent=t?(t.type==='tree'?'ЛКМ — рубить дерево':t.type==='rock'?'ЛКМ — добыть камень':'ЛКМ — добыть металл'):(player.selected===3?'E — построить укрытие':player.selected===4?'E — съесть ягоды':player.selected===5?'E — выпить воду':'Исследуй остров и собирай ресурсы');if(toastTimer>0){toastTimer-=dt;if(toastTimer<=0)toast.style.opacity=0}if(Math.floor(elapsed)%5===0&&Math.floor(elapsed)!==0){/* passive survival loop */}ui();axe.visible=player.selected===1||player.selected===2;arm.visible=axe.visible; swing=Math.max(0,swing-dt*5);axe.rotation.z=Math.sin(now*.008)*.015-swing*.65;axe.rotation.x=-swing*.45;axe.position.y=-.38-swing*.12}
 // atmospheric light shifts as time passes
 const sunY=Math.sin((daytime/24)*Math.PI*2-Math.PI/2);sun.position.set(-35,30+sunY*22,25);sun.intensity=.9+Math.max(0,sunY)*1.5;scene.background.setHSL(.53,.2,.42+Math.max(0,sunY)*.18);scene.fog.color.copy(scene.background);
 renderer.render(scene,camera)}
requestAnimationFrame(animate);
addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});
ui();
</script>
</body></html>
